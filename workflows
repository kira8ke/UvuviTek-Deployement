eduleTrigger","typeVersion":1.2,"position":[-784,-16],"id":"31c284b5-f731-4da4-af73-585e8c448d44","name":"IoT Data Collection Trigger"},{"parameters":{"operation":"get","tableId":"ponds","filters":{"conditions":[{"keyName":"id","keyValue":"status.eq.active"},{"keyName":"pond_name","keyValue":"status.eq.active"},{"keyName":"fish_species","keyValue":"status.eq.active"},{"keyName":"pond_type","keyValue":"status.eq.active"},{"keyName":"number_of_fingerlings","keyValue":"status.eq.active"},{"keyName":"start_stock_date","keyValue":"status.eq.active"},{"keyName":"user_id","keyValue":"status.eq.active"}]}},"type":"n8n-nodes-base.supabase","typeVersion":1,"position":[-576,-16],"id":"0c99a69d-b92f-4b0e-8bca-69ad4bb33218","name":"Fetch Active Ponds","credentials":{"supabaseApi":{"id":"dATixhIUXNVHyKke","name":"Supabase account"}}},{"parameters":{"jsCode":"const ponds = $input.all();\nlet allSensorReadings = [];\n\n// IoT sensor data generation for each pond\nponds.forEach(pondData => {\n  const pond = pondData.json;\n  const currentTime = new Date().toISOString();\n  \n  // Calculate days since stocking for growth patterns\n  const stockingDate = new Date(pond.start_stock_date);\n  const daysOld = Math.floor((new Date() - stockingDate) / (1000 * 60 * 60 * 24));\n  \n  // Generate realistic IoT sensor readings with species-specific parameters\n  const speciesParams = {\n    tilapia: { optTemp: 28, optPH: 7.2, optOxygen: 6.5, mortRate: 3 },\n    catfish: { optTemp: 30, optPH: 7.0, optOxygen: 6.0, mortRate: 4 },\n    trout: { optTemp: 15, optPH: 7.5, optOxygen: 8.0, mortRate: 2 },\n    bass: { optTemp: 25, optPH: 7.3, optOxygen: 7.0, mortRate: 3.5 }\n  };\n  \n  const params = speciesParams[pond.fish_species] || speciesParams.tilapia;\n  \n  // Temperature sensor with realistic variations and day/night cycle\n  const hourOfDay = new Date().getHours();\n  const dayNightFactor = Math.sin((hourOfDay - 6) * Math.PI / 12) * 2; // Day warmer than night\n  const randomVariation = (Math.random() - 0.5) * 4;\n  const temperature = Math.round((params.optTemp + dayNightFactor + randomVariation) * 10) / 10;\n  \n  // pH sensor with buffer variations\n  const phVariation = (Math.random() - 0.5) * 1.5;\n  const phLevel = Math.round((params.optPH + phVariation) * 10) / 10;\n  \n  // Dissolved Oxygen with temperature correlation (warmer = less oxygen)\n  const tempEffect = (temperature - params.optTemp) * -0.2;\n  const oxygenVariation = (Math.random() - 0.5) * 2;\n  const dissolvedOxygen = Math.round((params.optOxygen + tempEffect + oxygenVariation) * 10) / 10;\n  \n  // Ammonia levels (increases with fish waste over time)\n  const ammoniaBase = Math.min(0.5, daysOld * 0.002 + (pond.number_of_fingerlings / 1000) * 0.1);\n  const ammoniaVariation = Math.random() * 0.05;\n  const ammoniaLevel = Math.round((ammoniaBase + ammoniaVariation) * 1000) / 1000;\n  \n  // Additional IoT sensors\n  const turbidity = Math.round((10 + Math.random() * 20) * 10) / 10; // NTU\n  const conductivity = Math.round((200 + Math.random() * 100) * 10) / 10; // μS/cm\n  const waterLevel = Math.round((0.8 + Math.random() * 0.4) * 100) / 100; // meters\n  \n  // Create sensor readings array\n  const sensorReadings = [\n    {\n      pond_id: pond.id,\n      sensor_type: 'temperature',\n      value: temperature,\n      unit: '°C',\n      device_id: `TEMP_${pond.id.substring(0, 8)}`,\n      timestamp: currentTime,\n      status: temperature > 35 || temperature < 15 ? 'warning' : 'active'\n    },\n    {\n      pond_id: pond.id,\n      sensor_type: 'ph_level',\n      value: phLevel,\n      unit: 'pH',\n      device_id: `PH_${pond.id.substring(0, 8)}`,\n      timestamp: currentTime,\n      status: phLevel > 9 || phLevel < 6 ? 'warning' : 'active'\n    },\n    {\n      pond_id: pond.id,\n      sensor_type: 'dissolved_oxygen',\n      value: dissolvedOxygen,\n      unit: 'mg/L',\n      device_id: `DO_${pond.id.substring(0, 8)}`,\n      timestamp: currentTime,\n      status: dissolvedOxygen < 4 ? 'critical' : 'active'\n    },\n    {\n      pond_id: pond.id,\n      sensor_type: 'ammonia',\n      value: ammoniaLevel,\n      unit: 'mg/L',\n      device_id: `NH3_${pond.id.substring(0, 8)}`,\n      timestamp: currentTime,\n      status: ammoniaLevel > 0.3 ? 'warning' : 'active'\n    },\n    {\n      pond_id: pond.id,\n      sensor_type: 'turbidity',\n      value: turbidity,\n      unit: 'NTU',\n      device_id: `TURB_${pond.id.substring(0, 8)}`,\n      timestamp: currentTime,\n      status: 'active'\n    },\n    {\n      pond_id: pond.id,\n      sensor_type: 'conductivity',\n      value: conductivity,\n      unit: 'μS/cm',\n      device_id: `COND_${pond.id.substring(0, 8)}`,\n      timestamp: currentTime,\n      status: 'active'\n    }\n  ];\n  \n  allSensorReadings.push(...sensorReadings);\n});\n\nreturn allSensorReadings.map(reading => ({ json: reading }));"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[-368,-16],"id":"10e89fde-363e-4d80-b88d-78f0f44b784e","name":"IoT Sensor Data Generator"},{"parameters":{"jsCode":"const sensorData = $input.all();\nlet anomalies = [];\nlet pondAggregates = {};\n\n// Group sensor data by pond for comprehensive analysis\nsensorData.forEach(sensor => {\n  const data = sensor.json;\n  if (!pondAggregates[data.pond_id]) {\n    pondAggregates[data.pond_id] = {};\n  }\n  pondAggregates[data.pond_id][data.sensor_type] = data.value;\n});\n\n// Advanced ML Anomaly Detection Algorithms\nconst mlAnomalyDetection = (pondId, metrics) => {\n  const detectedAnomalies = [];\n  \n  // Define ML baselines (trained parameters)\n  const speciesBaselines = {\n    default: {\n      temperature: { mean: 27.5, std: 2.5, min: 20, max: 32 },\n      ph_level: { mean: 7.2, std: 0.8, min: 6.5, max: 8.5 },\n      dissolved_oxygen: { mean: 6.5, std: 1.2, min: 5.0, max: 10.0 },\n      ammonia: { mean: 0.1, std: 0.08, min: 0, max: 0.25 },\n      turbidity: { mean: 15, std: 8, min: 5, max: 40 },\n      conductivity: { mean: 250, std: 50, min: 150, max: 400 }\n    }\n  };\n  \n  const baseline = speciesBaselines.default;\n  \n  // ML Algorithm 1: Z-Score Anomaly Detection\n  const zScoreDetection = (value, mean, std) => {\n    if (std === 0) return 0;\n    return Math.abs(value - mean) / std;\n  };\n  \n  // ML Algorithm 2: Isolation Forest Score (simplified)\n  const isolationScore = (value, min, max) => {\n    const range = max - min;\n    const normalizedValue = (value - min) / range;\n    // Higher scores for values near extremes\n    return Math.min(normalizedValue, 1 - normalizedValue) * 2;\n  };\n  \n  // ML Algorithm 3: Multi-variate Correlation Analysis\n  const correlationAnomaly = (temp, oxygen, ph) => {\n    // Temperature-Oxygen inverse correlation (warmer = less oxygen)\n    const expectedOxygen = 8 - (temp - 20) * 0.15;\n    const oxygenDeviation = Math.abs(oxygen - expectedOxygen);\n    \n    // pH-Ammonia correlation (higher ammonia = higher pH)\n    const expectedPH = 7.0 + (metrics.ammonia || 0.1) * 5;\n    const phDeviation = Math.abs(ph - expectedPH);\n    \n    return (oxygenDeviation + phDeviation) / 2;\n  };\n  \n  // Run ML algorithms on each metric\n  Object.entries(metrics).forEach(([metric, value]) => {\n    if (baseline[metric]) {\n      const base = baseline[metric];\n      \n      // Calculate anomaly scores using multiple algorithms\n      const zScore = zScoreDetection(value, base.mean, base.std);\n      const isoScore = isolationScore(value, base.min, base.max);\n      const corrScore = metric === 'temperature' ? \n        correlationAnomaly(value, metrics.dissolved_oxygen || 6, metrics.ph_level || 7) : 0;\n      \n      // Ensemble ML scoring (combine multiple algorithms)\n      const ensembleScore = (zScore * 0.5) + (isoScore * 0.3) + (corrScore * 0.2);\n      \n      // ML confidence calculation\n      const mlConfidence = Math.round(Math.min(99, Math.max(60, ensembleScore * 25)));\n      \n      // Anomaly threshold (ML decision boundary)\n      if (zScore > 2.0 || ensembleScore > 1.5) {\n        \n        // ML-powered severity assessment\n        let severity;\n        let priority;\n        if (zScore > 3.5 || ensembleScore > 2.5) {\n          severity = 'critical';\n          priority = 1;\n        } else if (zScore > 2.5 || ensembleScore > 2.0) {\n          severity = 'high';\n          priority = 2;\n        } else {\n          severity = 'medium'; \n          priority = 3;\n        }\n        \n        // ML recommendation engine\n        const getMLRecommendation = (metric, value, severity) => {\n          const recommendations = {\n            temperature: {\n              high: 'ML Alert: Temperature spike detected. Implement immediate cooling: increase water circulation, add shade cover, or introduce cool water influx.',\n              low: 'ML Alert: Temperature drop detected. Check heating systems and consider thermal insulation or greenhouse covering.'\n            },\n            ph_level: {\n              high: 'ML Alert: Alkalinity spike detected. Add organic matter (compost tea) or reduce feeding temporarily to lower pH naturally.',\n              low: 'ML Alert: Acidity increase detected. Add crushed limestone or wood ash gradually. Test water source quality.'\n            },\n            dissolved_oxygen: {\n              low: 'ML Critical: Oxygen depletion pattern detected. Emergency aeration required. Check for overcrowding and reduce feeding.'\n            },\n            ammonia: {\n              high: 'ML Critical: Ammonia toxicity pattern detected. Immediate water change (30%) and increase biological filtration. Check for dead fish.'\n            }\n          };\n          \n          const direction = value > base.mean ? 'high' : 'low';\n          return recommendations[metric]?.[direction] || `ML Alert: ${metric} anomaly detected. Monitor closely and consider corrective action.`;\n        };\n        \n        detectedAnomalies.push({\n          pond_id: pondId,\n          anomaly_type: `ML_${metric.toUpperCase()}_ANOMALY`,\n          metric_name: metric,\n          current_value: value,\n          expected_range: `${base.mean - base.std} - ${base.mean + base.std}`,\n          z_score: Math.round(zScore * 100) / 100,\n          isolation_score: Math.round(isoScore * 100) / 100,\n          ensemble_score: Math.round(ensembleScore * 100) / 100,\n          severity: severity,\n          priority: priority,\n          ml_confidence: mlConfidence,\n          algorithm_used: 'ensemble_ml_v1.2',\n          recommendation: getMLRecommendation(metric, value, severity),\n          created_at: new Date().toISOString()\n        });\n      }\n    }\n  });\n  \n  return detectedAnomalies;\n};\n\n// Process each pond through ML analysis\nObject.entries(pondAggregates).forEach(([pondId, metrics]) => {\n  const pondAnomalies = mlAnomalyDetection(pondId, metrics);\n  anomalies.push(...pondAnomalies);\n});\n\nreturn anomalies.map(anomaly => ({ json: anomaly }));"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[-160,-16],"id":"ca46ffe3-f013-4f4f-b817-7f25e6fd6447","name":"Advanced ML Anomaly Detection"},{"parameters":{"tableId":"pond_alerts","dataToSend":"autoMapInputData"},"type":"n8n-nodes-base.supabase","typeVersion":1,"position":[512,-16],"id":"211b83ca-16f1-4980-a7d4-006d2958bd89","name":"Store Smart Alerts","credentials":{"supabaseApi":{"id":"dATixhIUXNVHyKke","name":"Supabase account"}}},{"parameters":{"tableId":"sensor_readings","dataToSend":"autoMapInputData"},"type":"n8n-nodes-base.supabase","typeVersion":1,"position":[-48,192],"id":"8c06025e-0952-49f8-951f-8cc9b848d13d","name":"Store IoT Sensor Readings","credentials":{"supabaseApi":{"id":"dATixhIUXNVHyKke","name":"Supabase account"}}},{"parameters":{"tableId":"ml_anomalies","dataToSend":"autoMapInputData"},"type":"n8n-nodes-base.supabase","typeVersion":1,"position":[48,-16],"id":"08f3d5ba-3972-452c-8fc4-cd0a562bf951","name":"Store ML Anomalies","credentials":{"supabaseApi":{"id":"dATixhIUXNVHyKke","name":"Supabase account"}}},{"parameters":{"jsCode":"const anomalies = $('Advanced ML Anomaly Detection').all();\nlet alertsToCreate = [];\n\n// Create intelligent alerts based on ML findings\nanomalies.forEach(anomalyData => {\n  const anomaly = anomalyData.json;\n  \n  // Smart alert aggregation (don't spam users)\n  const alertKey = `${anomaly.pond_id}_${anomaly.metric_name}`;\n  \n  alertsToCreate.push({\n    pond_id: anomaly.pond_id,\n    alert_type: anomaly.anomaly_type,\n    title: `🤖 AI Detection: ${anomaly.metric_name.replace('_', ' ').toUpperCase()} Anomaly`,\n    message: `ML algorithms detected ${anomaly.metric_name} anomaly (${anomaly.current_value}). Confidence: ${anomaly.ml_confidence}%`,\n    severity: anomaly.severity,\n    priority: anomaly.priority,\n    ml_generated: true,\n    ml_confidence: anomaly.ml_confidence,\n    algorithm_used: anomaly.algorithm_used,\n    recommendation: anomaly.recommendation,\n    metadata: JSON.stringify({\n      z_score: anomaly.z_score,\n      ensemble_score: anomaly.ensemble_score,\n      expected_range: anomaly.expected_range\n    }),\n    created_at: new Date().toISOString(),\n    status: 'active'\n  });\n});\n\nreturn alertsToCreate.map(alert => ({ json: alert }));"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[272,-16],"id":"927ced00-5339-43d5-9da7-d4e46d9acf68","name":"Smart Alert Dispatcher"}],"connections":{"IoT Data Collection Trigger":{"main":[[{"node":"Fetch Active Ponds","type":"main","index":0}]]},"Fetch Active Ponds":{"main":[[{"node":"IoT Sensor Data Generator","type":"main","index":0}]]},"IoT Sensor Data Generator":{"main":[[{"node":"Store IoT Sensor Readings","type":"main","index":0},{"node":"Advanced ML Anomaly Detection","type":"main","index":0}]]},"Advanced ML Anomaly Detection":{"main":[[{"node":"Store IoT Sensor Readings","type":"main","index":0},{"node":"Store ML Anomalies","type":"main","index":0}]]},"Store IoT Sensor Readings":{"main":[[]]},"Store ML Anomalies":{"main":[[{"node":"Smart Alert