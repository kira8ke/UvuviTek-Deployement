,"name":"Supabase account"}}},{"parameters":{"jsCode":"const marketInsights = $input.all();\nlet marketAlerts = [];\n\nmarketInsights.forEach(insightData => {\n  const insight = insightData.json;\n  \n  // Generate alerts for significant market movements\n  const alerts = [];\n  \n  // Price spike alert\n  if (Math.abs(insight.price_change_percent) > 10 && insight.confidence_score > 70) {\n    const direction = insight.price_change_percent > 0 ? 'increase' : 'decrease';\n    alerts.push({\n      alert_type: 'MARKET_PRICE_MOVEMENT',\n      title: `🚀 Market Alert: ${insight.fish_type.toUpperCase()} Price ${direction.toUpperCase()}`,\n      message: `ML prediction shows ${Math.abs(insight.price_change_percent)}% price ${direction} in ${insight.region}. Confidence: ${insight.confidence_score}%`,\n      severity: Math.abs(insight.price_change_percent) > 15 ? 'high' : 'medium',\n      ml_confidence: insight.confidence_score,\n      recommendation: insight.recommendation\n    });\n  }\n  \n  // High volatility alert\n  if (insight.risk_level === 'high' && insight.confidence_score > 60) {\n    alerts.push({\n      alert_type: 'MARKET_HIGH_VOLATILITY',\n      title: `⚠️ Market Alert: High Volatility Detected`,\n      message: `${insight.fish_type} prices in ${insight.region} showing high volatility. Consider risk management strategies.`,\n      severity: 'medium',\n      ml_confidence: insight.confidence_score,\n      recommendation: 'Monitor market closely before making trading decisions'\n    });\n  }\n  \n  // Strong trend alert\n  if (insight.ml_model_accuracy > 80 && Math.abs(insight.price_change_percent) > 5) {\n    const trendType = insight.trend_direction === 'up' ? 'bullish' : 'bearish';\n    alerts.push({\n      alert_type: 'MARKET_TREND_SIGNAL',\n      title: `📈 Market Trend: ${trendType.toUpperCase()} Signal`,\n      message: `Strong ${trendType} trend detected for ${insight.fish_type} in ${insight.region}. ML accuracy: ${insight.ml_model_accuracy}%`,\n      severity: 'low',\n      ml_confidence: insight.confidence_score,\n      recommendation: `Consider ${trendType === 'bullish' ? 'holding stock longer' : 'selling current inventory'}`\n    });\n  }\n  \n  // Add metadata to alerts\n  alerts.forEach(alert => {\n    marketAlerts.push({\n      ...alert,\n      fish_type: insight.fish_type,\n      region: insight.region,\n      source: 'ml_market_analysis',\n      created_at: new Date().toISOString(),\n      expires_at: new Date(Date.now() + 24 * 60 * 60 * 1000).toISOString(), // 24 hours\n      metadata: JSON.stringify({\n        price_change: insight.price_change_percent,\n        current_price: insight.current_price,\n        predicted_price: insight.predicted_price_7d,\n        model_accuracy: insight.ml_model_accuracy\n      })\n    });\n  });\n});\n\nreturn marketAlerts.map(alert => ({ json: alert }));"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[160,320],"id":"74bb5879-6020-43b3-ae01-244b5f1a5dd0","name":"Market Alert Generator"},{"parameters":{"tableId":"rpc/check_market_alerts","dataToSend":"autoMapInputData"},"type":"n8n-nodes-base.supabase","typeVersion":1,"position":[368,320],"id":"10c273c1-7a52-444e-bdba-218221104e2d","name":"Store Market Alerts","credentials":{"supabaseApi":{"id":"dATixhIUXNVHyKke","name":"Supabase account"}}},{"parameters":{"jsCode":"// Generate current market prices based on ML predictions\nconst fishTypes = ['tilapia', 'catfish', 'trout', 'bass'];\nconst regions = ['nairobi', 'mombasa', 'kisumu', 'nakuru', 'eldoret'];\n\nlet updatedPrices = [];\n\nfishTypes.forEach(fishType => {\n  regions.forEach(region => {\n    // Base prices with regional variations\n    const basePrices = {\n      tilapia: { nairobi: 380, mombasa: 360, kisumu: 340, nakuru: 350, eldoret: 345 },\n      catfish: { nairobi: 420, mombasa: 400, kisumu: 380, nakuru: 390, eldoret: 385 },\n      trout: { nairobi: 650, mombasa: 600, kisumu: 580, nakuru: 620, eldoret: 610 },\n      bass: { nairobi: 520, mombasa: 500, kisumu: 480, nakuru: 490, eldoret: 485 }\n    };\n    \n    const basePrice = basePrices[fishType][region];\n    \n    // Apply ML-influenced price variations\n    const mlInfluence = (Math.random() - 0.5) * 0.15; // ±15% variation\n    const seasonalFactor = Math.sin(Date.now() / (1000 * 60 * 60 * 24 * 30)) * 0.1; // Monthly cycle\n    const demandFactor = Math.random() * 0.1 - 0.05; // ±5% demand variation\n    \n    const finalPrice = Math.round(basePrice * (1 + mlInfluence + seasonalFactor + demandFactor));\n    \n    updatedPrices.push({\n      fish_type: fishType,\n      region: region,\n      date: new Date().toISOString().split('T')[0],\n      price: Math.max(100, finalPrice), // Minimum price floor\n      currency: 'KES',\n      unit: 'kg',\n      market_name: `${region.charAt(0).toUpperCase() + region.slice(1)} Central Market`,\n      data_source: 'ml_simulation',\n      updated_at: new Date().toISOString()\n    });\n  });\n});\n\nreturn updatedPrices.map(price => ({ json: price }));"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[576,320],"id":"14fe305b-bf19-4368-b9fe-8f6999e50ee3","name":"Generate Updated Prices"},{"parameters":{"tableId":"market price"},"type":"n8n-nodes-base.supabase","typeVersion":1,"position":[784,320],"id":"c4cf267a-cc41-42f9-983b-7cf3f3ac051b","name":"Store Current Market Prices","credentials":{"supabaseApi":{"id":"dATixhIUXNVHyKke","name":"Supabase account"}}}],"connections":{"Market Intelligence Scheduler":{"main":[[{"node":"Get Market History","type":"main","index":0}]]},"Get Market History":{"main":[[{"node":"Advanced Market ML Analysis","type":"main","index":0}]]},"Advanced Market ML Analysis":{"main":[[{"node":"Store ML Market Analysis","type":"main","index":0}]]},"Store ML Market Analysis":{"main":[[{"node":"Market Alert Generator","type":"main","index":0}]]},"Market Alert Generator":{"main":[[{"node":"Store Market Alerts","type":"main","index":0}]]},"Store Market Alerts":{"main":[[{"node":"Generate Updated Prices"