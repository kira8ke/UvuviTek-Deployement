n  const predictedWeight = model.maxWeight / (1 + Math.exp(-model.a * (daysOld - model.b * 30)));\n  \n  // Add environmental factors (temperature, pH impact)\n  const tempFactor = pondData.water_temperature > 28 ? 0.95 : 1.05;\n  const phFactor = (pondData.ph_level >= 7 && pondData.ph_level <= 8) ? 1.1 : 0.9;\n  \n  return {\n    predicted_weight_7days: Math.round(predictedWeight * tempFactor * phFactor * 1000) / 1000,\n    predicted_harvest_date: new Date(Date.now() + (30 - daysOld) * 24 * 60 * 60 * 1000).toISOString().split('T')[0],\n    confidence_score: 0.85,\n    growth_rate_prediction: 'optimal' // or 'slow', 'fast'\n  };\n};\n\n// Add ML predictions to your pond metrics\nconst mlPredictions = predictGrowth(pondData.estimated_weight, daysSinceStocking, pondData.fish_species);\n\nreturn [{\n  json: {\n    ...pondData,\n    ml_predictions: mlPredictions\n  }\n}];"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[224,-32],"id":"a9060c64-956d-46a4-92f0-1845a61acaee","name":"ML Growth Prediction"},{"parameters":{"tableId":"pond_alerts","dataToSend":"autoMapInputData"},"type":"n8n-nodes-base.supabase","typeVersion":1,"position":[816,-32],"id":"9a7963d9-afe7-48b7-a296-de31170d3c43","name":"Create a row","credentials":{"supabaseApi":{"id":"dATixhIUXNVHyKke","name":"Supabase account"}}},{"parameters":{"jsCode":"const ponds = $input.all();\nlet pondUpdates = [];\n\nponds.forEach(pond => {\n  const pondData = pond.json;\n  \n  // Calculate days since stocking\n  const stockingDate = new Date(pondData.start_stock_date);\n  const today = new Date();\n  const daysSinceStocking = Math.floor((today - stockingDate) / (1000 * 60 * 60 * 24));\n  \n  // Simulate realistic pond metrics\n  // Enhanced demo version with more dramatic changes every 3 seconds\nconst metrics = {\n  pond_id: pondData.id,\n  timestamp: new Date().toISOString(),\n  \n  // More dramatic wave patterns for 3-second updates\n  water_temperature: Math.round((26 + Math.sin(Date.now() / 3000) * 4 + Math.random() * 2) * 10) / 10, // 24-32°C with clear wave pattern\n  ph_level: Math.round((7.2 + Math.sin(Date.now() / 4000) * 1 + Math.random() * 0.5) * 10) / 10, // 6.5-8.5 with smooth changes\n  dissolved_oxygen: Math.round((6 + Math.sin(Date.now() / 5000) * 2 + Math.random() * 1) * 10) / 10, // 4-9 mg/L\n  \n  // More frequent status changes for demo impact\n  mortality_rate: Math.max(0, Math.round((2 + Math.random() * 6 + Math.sin(Date.now() / 6000)) * 10) / 10), // 2-8%\n  \n  // Visibly growing weight every 3 seconds\n  estimated_weight: Math.round(pondData.stocking_weight * (1 + daysSinceStocking * 0.02 + (Date.now() % 30000) / 100000)), \n  \n  // Higher chance of status changes for demo drama\n  needs_cleaning: Math.random() > 0.6, // 40% chance (every few updates)\n  needs_treatment: Math.random() > 0.85, // 15% chance\n  feeding_completed: Math.random() > 0.3, // 70% chance\n  \n  // Add demo-friendly fields\n  oxygen_trend: Math.sin(Date.now() / 3000) > 0 ? 'increasing' : 'decreasing',\n  temperature_status: (26 + Math.sin(Date.now() / 3000) * 4) > 28 ? 'warm' : 'optimal'\n};\n  \n  pondUpdates.push(metrics);\n});\n\nreturn pondUpdates.map(update => ({ json: update }));"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[16,-32],"id":"cdfae540-4717-49ab-b4a4-cabb543a06fc","name":"Generate Pond metrics"}],"connections":{"Schedule Trigger1":{"main":[[{"node":"Get a row1","type":"main","index":0}]]},"Create a row1":{"main":[[{"node":"Check Thresholds","type":"main","index":0}]]},"Get a row1":{"main":[[{"node":"Generate Pond metrics","type":"main","index":0}]]},"ML Growth Prediction":{"main":[[{"node":"Create a row1","type":"main","index":0}]]},"Check Thresholds":{"main":[[{"node":"Create a row","type":"main","index":0}]]},"Generate Pond metrics":{"main":[[{"node":"ML Growth Prediction","type":"main","index":0}]]}},"settings":{"executionOrder":"v1"},"staticData":null,"meta":{"templateCredsSetupCompleted":true},"pinData":{},"versionId":"e1fbb120-b3fc-456